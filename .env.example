# =============================================================================
#  Bot de música para Discord — configuração
#  Copie este arquivo para ".env" e preencha. Detalhes em docs/03-instalacao-e-execucao.md
# =============================================================================

# --- Discord (obrigatório) ---------------------------------------------------
# Developer Portal > sua aplicação > Bot > Reset Token. NUNCA compartilhe nem versione.
DISCORD_TOKEN=

# ID de um servidor para registrar os comandos instantaneamente durante o desenvolvimento.
# Deixe vazio para registrar globalmente (todos os servidores).
DISCORD_GUILD_ID=

# --- Spotify (opcional) ------------------------------------------------------
# Sem credenciais, links do Spotify funcionam pela página pública (até ~100 músicas por playlist).
# Com credenciais, faixas e álbuns usam a API oficial (álbuns completos, com paginação).
# https://developer.spotify.com/dashboard > Create app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Comportamento do player -------------------------------------------------
DEFAULT_VOLUME=50            # volume inicial em % (0 a 200)
MAX_QUEUE_SIZE=100           # máximo de músicas na fila de um servidor
MAX_PLAYLIST_SIZE=100        # máximo de músicas carregadas de uma playlist
IDLE_TIMEOUT_SECONDS=360     # sai do canal após X s sem tocar nada (0 = nunca sai)
ALONE_TIMEOUT_SECONDS=120     # sai após X s sozinho no canal (0 = nunca sai)


# --- Logs --------------------------------------------------------------------
NODE_ENV=development         # production = logs em JSON
LOG_LEVEL=info               # fatal | error | warn | info | debug | trace

{
  "name": "neruz-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Neruz Bot: bot de música para Discord (versão de visualização).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "commands:deploy": "node dist/scripts/deploy-commands.js",
    "commands:deploy:dev": "tsx src/scripts/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^2.0.0",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.1.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
